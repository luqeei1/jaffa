{
  "configById": {
    "3D!marco3d": {
      "cameraState": {
        "distance": 14,
        "perspective": false,
        "phi": 0.01,
        "thetaOffset": 90,
        "targetOffset": [
          0,
          0,
          0
        ],
        "target": [
          0,
          0,
          0
        ],
        "targetOrientation": [
          0,
          0,
          0,
          1
        ],
        "fovy": 45,
        "near": 0.5,
        "far": 5000
      },
      "followMode": "follow-position",
      "followTf": "base_link",
      "scene": {
        "enableStats": false,
        "transforms": {
          "showLabel": false,
          "axisScale": 0.6
        }
      },
      "transforms": {},
      "topics": {
        "/map": {
          "visible": true,
          "colorMode": "map",
          "alpha": 0.7
        },
        "/global_costmap/costmap": {
          "visible": false,
          "colorMode": "costmap",
          "alpha": 0.4
        },
        "/marco/belief/grid": {
          "visible": true,
          "colorMode": "custom",
          "minColor": "#ff000000",
          "maxColor": "#ff2020ff",
          "unknownColor": "#00000000",
          "invalidColor": "#00000000",
          "alpha": 0.85
        },
        "/marco/belief/markers": {
          "visible": true
        },
        "/marco/search/markers": {
          "visible": true
        },
        "/marco/belief/estimate": {
          "visible": true
        },
        "/marco/search/goal": {
          "visible": true
        },
        "/plan": {
          "visible": true,
          "lineWidth": 0.05
        },
        "/scan": {
          "visible": true,
          "pointSize": 3,
          "colorMode": "flat",
          "flatColor": "#ffffff99"
        }
      },
      "layers": {
        "grid": {
          "visible": true,
          "layerId": "foxglove.Grid",
          "frameId": "map",
          "size": 20,
          "divisions": 20,
          "lineWidth": 1,
          "color": "#248eff33",
          "position": [
            0,
            0,
            0
          ],
          "rotation": [
            0,
            0,
            0
          ],
          "order": 1
        }
      },
      "publish": {
        "type": "point",
        "pointTopic": "/goto/goal",
        "poseTopic": "/goal_pose",
        "poseEstimateTopic": "/initialpose",
        "poseEstimateXDeviation": 0.5,
        "poseEstimateYDeviation": 0.5,
        "poseEstimateThetaDeviation": 0.26
      },
      "imageMode": {}
    },
    "Image!marcocam": {
      "cameraTopic": "/marco/person/image/compressed",
      "imageMode": {
        "imageTopic": "/marco/person/image/compressed"
      },
      "enabledMarkerTopics": [],
      "synchronize": false,
      "transformMarkers": false
    },
    "DiagnosticSummary!marcodiag": {
      "minLevel": 0,
      "pinnedIds": [],
      "hardwareIdFilter": "marco",
      "topicToRender": "/diagnostics",
      "sortByLevel": false
    },
    "DiagnosticStatusPanel!marcostate": {
      "selectedHardwareId": "marco",
      "selectedName": "marco_search: search",
      "splitFraction": 0.45,
      "topicToRender": "/diagnostics",
      "numericPrecision": 2
    },
    "StateTransitions!marcophase": {
      "paths": [
        {
          "value": "/marco/search/phase.data",
          "timestampMethod": "receiveTime",
          "label": "search phase"
        },
        {
          "value": "/marco/search/sensing.data",
          "timestampMethod": "receiveTime",
          "label": "sensing"
        },
        {
          "value": "/marco/speech/active.data",
          "timestampMethod": "receiveTime",
          "label": "Marco speaking"
        },
        {
          "value": "/cmd_vel_mux/active.data",
          "timestampMethod": "receiveTime",
          "label": "who drives"
        }
      ],
      "isSynced": true
    },
    "Plot!marcobelief": {
      "paths": [
        {
          "value": "/marco/belief/peak_ratio.data",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "belief peak / uniform"
        },
        {
          "value": "/marco/belief/entropy.data",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "entropy (1 = no info)"
        }
      ],
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "sidebarDimension": 240
    },
    "Log!marcolog": {
      "searchTerms": [],
      "minLogLevel": 2,
      "topicToRender": "/rosout",
      "nameFilter": {}
    },
    "RawMessages!marcosummary": {
      "topicPath": "/marco/belief/summary",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false
    },
    "RawMessages!marcogoto": {
      "topicPath": "/goto/status",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false
    },
    "Publish!marcostart": {
      "topicName": "/marco/search/command",
      "datatype": "std_msgs/msg/String",
      "buttonText": "Start search",
      "buttonTooltip": "start (or resume) the search",
      "buttonColor": "#00a871",
      "advancedView": false,
      "value": "{\"data\": \"start\"}"
    },
    "Publish!marcostop": {
      "topicName": "/marco/search/command",
      "datatype": "std_msgs/msg/String",
      "buttonText": "Stop",
      "buttonTooltip": "stop the search and cancel the goal (not an e-stop)",
      "buttonColor": "#d12d2d",
      "advancedView": false,
      "value": "{\"data\": \"stop\"}"
    },
    "Publish!marcoreset": {
      "topicName": "/marco/search/command",
      "datatype": "std_msgs/msg/String",
      "buttonText": "Reset belief",
      "buttonTooltip": "clear the belief map",
      "buttonColor": "#6b5bd6",
      "advancedView": false,
      "value": "{\"data\": \"reset\"}"
    },
    "Tab!marcotabs": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "Diagnostics",
          "layout": {
            "first": "DiagnosticSummary!marcodiag",
            "second": "DiagnosticStatusPanel!marcostate",
            "direction": "column",
            "splitPercentage": 45
          }
        },
        {
          "title": "Belief JSON",
          "layout": "RawMessages!marcosummary"
        },
        {
          "title": "goto status",
          "layout": "RawMessages!marcogoto"
        }
      ]
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "direction": "row",
    "splitPercentage": 52,
    "first": "3D!marco3d",
    "second": {
      "direction": "column",
      "splitPercentage": 40,
      "first": {
        "direction": "row",
        "splitPercentage": 45,
        "first": "Image!marcocam",
        "second": "Tab!marcotabs"
      },
      "second": {
        "direction": "column",
        "splitPercentage": 45,
        "first": {
          "direction": "row",
          "splitPercentage": 55,
          "first": "StateTransitions!marcophase",
          "second": "Plot!marcobelief"
        },
        "second": {
          "direction": "row",
          "splitPercentage": 78,
          "first": "Log!marcolog",
          "second": {
            "direction": "column",
            "splitPercentage": 33,
            "first": "Publish!marcostart",
            "second": {
              "direction": "column",
              "splitPercentage": 50,
              "first": "Publish!marcostop",
              "second": "Publish!marcoreset"
            }
          }
        }
      }
    }
  }
}
